# Optional: Set OPENAI_API_KEY for temperature=0 LLM social-engineering intent scoring.
# Without a key (or with --no-llm), FishAgent runs 100% offline using deterministic header,
# DMARC/SPF/DKIM, Public-Suffix URL, HTML anchor, attachment, and linguistic heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
